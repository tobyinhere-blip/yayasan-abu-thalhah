---
// Header.astro Component
interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Beranda', key: 'beranda' },
  { href: '/tentang-kami', label: 'Tentang Kami', key: 'tentang-kami' },
  { href: '/unit-pendidikan', label: 'Unit Pendidikan', key: 'unit-pendidikan' },
  { href: '/berita', label: 'Berita', key: 'berita' },
  { href: '/galeri', label: 'Galeri', key: 'galeri' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 lg:h-24">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/logo_yayasan.png" class="h-12 lg:h-14 w-auto object-contain transition-transform group-hover:scale-105" alt="Logo Yayasan Islamic Center Abu Thalhah Al Anshari">
        <div class="flex flex-col justify-center leading-snug">
          <span class="font-sora font-semibold text-[10px] sm:text-[11px] uppercase tracking-wider text-smanti-orange">Yayasan Islamic Center</span>
          <span class="font-sora font-bold text-base lg:text-lg uppercase tracking-tight text-gray-900">Abu Thalhah</span>
          <span class="font-sora font-bold text-base lg:text-lg uppercase tracking-tight text-gray-900">Al Anshari</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 xl:px-4 py-2 rounded-md font-semibold text-sm transition-colors ${
              activePage === link.key
                ? 'text-smanti-orange bg-emerald-50'
                : 'text-gray-700 hover:text-smanti-orange hover:bg-gray-50'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Hubungi Kami Button (Desktop) -->
      <div class="hidden lg:flex items-center ml-2 xl:ml-4">
        <a href="https://api.whatsapp.com/send/?phone=+62 852-9222-7887&text&type=phone_number&app_absent=0"
          target="_blank" rel="noopener noreferrer"
          class="bg-smanti-red hover:bg-smanti-orange text-white px-4 xl:px-5 py-2.5 rounded-sm font-semibold transition-all flex items-center gap-2 text-sm shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
          style="background-color: #107163 !important; color: #ffffff !important;">
          <svg class="w-4 h-4 shrink-0" fill="#ffffff" viewBox="0 0 24 24">
            <path fill="#ffffff" d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.105 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span style="color: #ffffff !important;">Hubungi Kami</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="lg:hidden flex items-center">
        <button id="mobileMenuBtn" aria-label="Buka Menu Navigasi" class="text-gray-700 hover:text-smanti-red p-2 rounded-md focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden lg:hidden bg-white border-b border-gray-200 shadow-xl px-4 pt-2 pb-6">
    <div class="space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-3 py-2.5 rounded-md text-base font-semibold ${
            activePage === link.key
              ? 'text-smanti-orange bg-emerald-50'
              : 'text-gray-700 hover:text-smanti-orange hover:bg-gray-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3">
        <a href="https://api.whatsapp.com/send/?phone=+62 852-9222-7887&text&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full text-center text-white px-4 py-3 rounded-sm font-semibold text-sm shadow-md"
          style="background-color: #107163 !important; color: #ffffff !important;">
          <svg class="w-5 h-5 shrink-0" fill="#ffffff" viewBox="0 0 24 24">
            <path fill="#ffffff" d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.105 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span style="color: #ffffff !important;">Hubungi Kami</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle Script
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
