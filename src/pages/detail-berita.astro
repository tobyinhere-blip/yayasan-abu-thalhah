    <script is:inline src="/admin/js/firebase-config.js"></script>
    <script is:inline src="/admin/js/public-loader.js"></script>

    <!-- Detail Berita Dynamic Renderer -->
    <script is:inline>
        const _db = (typeof db !== 'undefined' && db) ? db : firebase.database();

        const newsData = {
            'peletakan-batu': {
                title: "Pembangunan Gedung Baru SDIT Al Mubarak Resmi Dimulai dengan Peletakan Batu Pertama",
                author: "Admin Yayasan",
                date: "8 Jan 2026",
                category: "Pengumuman",
                image: "https://cms.sitalmubarak.com/wp-content/uploads/2026/01/IMG_9776-scaled.jpg",
                body: `<p class="mb-4">Sebagai wujud komitmen dalam meningkatkan kualitas pendidikan Islam, <strong>SDIT Al Mubarak</strong> secara resmi memulai pembangunan dan renovasi fasilitas sekolah. Kegiatan ini diawali dengan <strong>peletakan batu pertama</strong>, yang menjadi simbol dimulainya ikhtiar bersama dalam menghadirkan lingkungan belajar yang lebih nyaman, aman, dan representatif bagi para peserta didik.</p><p class="mb-4">Pembangunan ini bukan sekadar proyek fisik, melainkan bagian dari visi besar SDIT Al Mubarak dalam mencetak generasi Qur’ani yang berilmu, berakhlak mulia, dan siap menghadapi tantangan masa depan.</p>`
            },
            'juara-mtq': {
                title: "Santri Yayasan Abu Thalhah Raih Juara Musabaqah Tilawatil Qur'an (MTQ) Tingkat Provinsi",
                author: "Admin Yayasan",
                date: "29 Jul 2026",
                category: "Prestasi Yayasan",
                image: "/siswi-berprestasii.png",
                body: `<p class="mb-4">Yayasan Islamic Center Abu Thalhah Al Anshari dengan rasa syukur yang mendalam mengumumkan prestasi luar biasa yang diraih oleh santriwati terbaik kami dalam ajang <strong>Musabaqah Tilawatil Qur'an (MTQ) Tingkat Provinsi Sulawesi Tengah 2026</strong>. Keberhasilan ini merupakan buah dari ketekunan, doa, dan bimbingan tanpa henti dari para asatidzah.</p><p class="mb-4">Dalam kompetisi yang berlangsung ketat dan diikuti oleh kafilah-kafilah terbaik dari berbagai kabupaten dan kota, santriwati kami berhasil menampilkan bacaan yang tartil, tajwid yang kokoh, serta keindahan lagu yang memukau para dewan hakim.</p>`
            },
            'psb': {
                title: "Penerimaan Santri Baru (PSB) Tahun Ajaran 2026/2027 Telah Resmi Dibuka",
                author: "Admin Yayasan",
                date: "25 Jul 2026",
                category: "Pengumuman",
                image: "/cta-image.png",
                body: `<p class="mb-4">Yayasan Islamic Center Abu Thalhah Al Anshari secara resmi membuka pendaftaran bagi calon santri dan siswa baru untuk tahun ajaran 2026/2027. Kami mengundang para orang tua untuk menitipkan pendidikan putra-putrinya di lembaga pendidikan kami yang berbasis nilai-nilai Islam, adab, dan tahfizh Al-Qur'an.</p>`
            },
            'parenting': {
                title: "Kajian Parenting Islami: Mendidik Anak dengan Keteladanan Akhlak Mulia",
                author: "Admin Yayasan",
                date: "23 Jul 2026",
                category: "Kajian Dakwah",
                image: "/sman3palu.sch.id/uploads/berita/1785161723_WhatsApp Image 2026-07-26 at 14.42.44.jpeg",
                body: `<p class="mb-4">Dalam rangka mempererat sinergi antara pihak sekolah dan wali santri, Yayasan Islamic Center Abu Thalhah Al Anshari sukses menyelenggarakan kajian parenting bulanan dengan tema <strong>"Mendidik Anak dengan Keteladanan Akhlak Mulia"</strong>.</p>`
            },
            'program-tahfidz': {
                title: "Program Unggulan Tahfidz Al-Qur'an & Olahraga Sunnah Memanah Santri",
                author: "Admin Yayasan",
                date: "20 Jul 2026",
                category: "Kajian Dakwah",
                image: "/sman3palu.sch.id/uploads/berita/1784805517_Screenshot 2026-07-23 at 19.17.55.png",
                body: `<p class="mb-4">Yayasan Islamic Center Abu Thalhah Al Anshari terus berupaya mengoptimalkan bakat dan karakter santri melalui perpaduan program unggulan: <strong>tahfizh Al-Qur'an</strong> dan <strong>olahraga sunnah memanah</strong>.</p>`
            }
        };

        function renderArticle(id, article, allData) {
            if (!article) return;
            document.getElementById('page-title').innerText = `${article.title || 'Detail Berita'} - Yayasan Islamic Center Abu Thalhah Al Anshari`;
            
            const catEl = document.getElementById('article-category');
            if (catEl) catEl.innerText = article.category || 'Berita';
            
            const titleEl = document.getElementById('article-title');
            if (titleEl) titleEl.innerText = article.title || '';
            
            const authorEl = document.getElementById('article-author');
            if (authorEl) authorEl.innerText = article.author || 'Admin Yayasan';
            
            const dateEl = document.getElementById('article-date');
            if (dateEl) dateEl.innerText = article.date || '';

            const imgWrapper = document.querySelector('.news-featured-img-wrapper');
            const imgEl = document.getElementById('article-image');
            const imgSrc = article.image || article.imageUrl;
            
            if (imgEl && imgSrc && imgSrc.trim() !== '') {
                imgEl.src = imgSrc;
                imgEl.alt = article.title || '';
                if (imgSrc.includes('logo_yayasan') || imgSrc.includes('cta-image')) {
                    imgEl.style.width = "auto";
                    imgEl.style.height = "220px";
                    imgEl.style.objectFit = "contain";
                    imgEl.style.padding = "24px";
                } else {
                    imgEl.style.width = "100%";
                    imgEl.style.height = "auto";
                    imgEl.style.objectFit = "cover";
                    imgEl.style.padding = "0px";
                }
                if (imgWrapper) imgWrapper.style.display = 'flex';
            } else if (imgWrapper) {
                imgWrapper.style.display = 'none';
            }

            const bodyEl = document.getElementById('article-body');
            if (bodyEl) {
                bodyEl.innerHTML = article.body || article.excerpt || '<p>Tidak ada isi berita.</p>';
            }

            const loadingEl = document.getElementById('loading-state');
            const contentEl = document.getElementById('article-content');
            if (loadingEl) loadingEl.style.display = 'none';
            if (contentEl) contentEl.style.display = 'block';

            // Sidebar (Berita Lainnya)
            const sidebarList = document.getElementById('sidebar-list');
            if (sidebarList && allData) {
                sidebarList.innerHTML = '';
                const keys = Object.keys(allData).filter(itemKey => itemKey !== id);
                const isAstro = !window.location.pathname.endsWith('.html');
                keys.slice(0, 3).forEach(otherId => {
                    const other = allData[otherId];
                    const card = document.createElement('a');
                    card.href = isAstro ? `/detail-berita?id=${otherId}` : `detail-berita.html?id=${otherId}`;
                    card.className = "news-sidebar-card";
                    card.style.cssText = "display: flex !important; flex-direction: row !important; gap: 16px !important; align-items: flex-start !important; text-decoration: none !important; color: inherit !important; padding: 4px 0 !important;";
                    
                    const otherImg = other.image || other.imageUrl || '/logo_yayasan.png';
                    let imgMarkup = `<img src="${otherImg}" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.src='/logo_yayasan.png';this.style.objectFit='contain';this.style.padding='4px'">`;
                    if (otherImg.includes('logo_yayasan') || otherImg.includes('cta-image')) {
                        imgMarkup = `<img src="${otherImg}" alt="" style="object-fit: contain; padding: 4px; width: 100%; height: 100%; display:block;">`;
                    }
                    card.innerHTML = `
                        <div class="news-sidebar-card-img-wrapper" style="width: 64px !important; height: 64px !important; border-radius: 8px !important; overflow: hidden !important; background-color: #f0fdf4 !important; border: 1px solid #e5e7eb !important; flex-shrink: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important;">${imgMarkup}</div>
                        <div class="news-sidebar-card-content" style="flex: 1 1 0% !important; min-width: 0 !important;">
                            <h4 class="news-sidebar-card-title" style="font-family: Poppins, sans-serif !important; font-size: 14px !important; font-weight: 600 !important; color: #1f2937 !important; line-height: 1.4 !important; margin: 0 !important; display: -webkit-box !important; -webkit-line-clamp: 3 !important; -webkit-box-orient: vertical !important; overflow: hidden !important;">${other.title || ''}</h4>
                        </div>
                    `;
                    sidebarList.appendChild(card);
                });
            }
        }

        function initDetailBerita() {
            const urlParams = new URLSearchParams(window.location.search);
            let id = urlParams.get('id');

            _db.ref('berita').once('value').then(snap => {
                if (snap.exists()) {
                    const fbData = snap.val();
                    if (id && fbData[id]) {
                        renderArticle(id, fbData[id], fbData);
                        return;
                    }
                    if (id && newsData[id]) {
                        renderArticle(id, newsData[id], fbData);
                        return;
                    }
                    const firstKey = Object.keys(fbData)[0];
                    if (firstKey) {
                        renderArticle(firstKey, fbData[firstKey], fbData);
                        return;
                    }
                }
                if (!id || !newsData[id]) id = 'juara-mtq';
                renderArticle(id, newsData[id], newsData);
            }).catch(() => {
                if (!id || !newsData[id]) id = 'juara-mtq';
                renderArticle(id, newsData[id], newsData);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener("DOMContentLoaded", initDetailBerita);
        } else {
            initDetailBerita();
        }
    </script>
</body>
